{
  "name": "transactional-emails",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, minimal transactional email template generator. Own setup, no monorepo dependency.",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:real-data": "vitest run tests/integration",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\"",
    "generate:template": "node --experimental-strip-types --no-warnings scripts/generate-template.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
