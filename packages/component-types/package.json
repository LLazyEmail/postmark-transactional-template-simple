{
  "name": "@llazyemail/component-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared email component prop types. No renderer, no host imports.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/postmark-transactional-template-simple.git",
    "directory": "packages/component-types"
  }
